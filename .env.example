# ── Authentication (Google OAuth) ───────────────────────────────────────────
# Whitelisted login. Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URIs: <PUBLIC_URL>/auth/callback
# (e.g. https://develops-vpn-mandatory-far.trycloudflare.com/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google emails that are allowed in.
AUTH_ALLOWED_EMAILS=ritam4jnu@gmail.com,dannydegen101@gmail.com,daniel@quaneqogroup.com

# Random secret used to sign session cookies — generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SESSION_SECRET=

# Optional — force a specific redirect URI (otherwise derived from request host).
# Set this when behind a tunnel that doesn't forward Host correctly.
# AUTH_REDIRECT_URI=https://your-tunnel-url.trycloudflare.com/auth/callback

# Bearer token for the /mcp endpoint (used by Hermes Agent). Pick anything;
# 32+ random chars recommended. Hermes config sends this in the Authorization
# header. Leave blank to disable MCP auth (only safe if localhost-only).
MCP_API_KEY=