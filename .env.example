FRED_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_TIMEZONE=Europe/London
DISPLAY_TIMEZONE=Europe/London
PERPLEXITY_API_KEY=

# Steno (Real Vision) credentials — copied from steno-bot for the mirror engine
RV_EMAIL=
RV_PASSWORD=

# Claude API for PDF extraction
or ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
CLAUDE_MODEL=claude-sonnet-4-6

# IBKR Flex Web Service
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# ── Authentication (Google OAuth) ───────────────────────────────────────────
# Whitelisted login. Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URIs: <PUBLIC_URL>/auth/callback
# (e.g. https://develops-vpn-mandatory-far.trycloudflare.com/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of Google emails that are allowed in.
AUTH_ALLOWED_EMAILS=ritam4jnu@gmail.com,dannydegen101@gmail.com,daniel@quaneqogroup.com

# Random secret used to sign session cookies — generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SESSION_SECRET=

# Optional — force a specific redirect URI (otherwise derived from request host).
# Set this when behind a tunnel that doesn't forward Host correctly.
# AUTH_REDIRECT_URI=https://your-tunnel-url.trycloudflare.com/auth/callback

# Bearer token for the /mcp endpoint (used by Hermes Agent). Pick anything;
# 32+ random chars recommended. Hermes config sends this in the Authorization
# header. Leave blank to disable MCP auth (only safe if localhost-only).
MCP_API_KEY=
# ── Technical Signals Layer (docs/technical-signals-layer-scope.md) ─────────
# The engine works with none of these set; the defaults are the shipped ones.

# §3.3 price data. With a Twelve Data key set, the default is a HYBRID:
#   bars   -> yfinance   (no rate limit, better intraday volume, but no search)
#   search -> twelvedata (real prefix search = §6.1 autocomplete)
# Tested live: both feeds produce identical scores, regimes and TD counts.
TWELVE_DATA_API_KEY=
# Move bars to Twelve Data too. Works, but its basic plan is 8 req/min (a 50-name
# run takes ~6 min) and its intraday volume lags badly (2% of median mid-session
# vs yfinance's 44%), which under-scores §5's volume component on daytime lookups.
# SIGNALS_OHLCV_PROVIDER=twelvedata
# Force search back to the bars provider (disables autocomplete).
# SIGNALS_SEARCH_PROVIDER=yfinance
# Raise if the Twelve Data plan is upgraded from basic (8/min, 800/day).
# TWELVE_DATA_RPM=8

# §3.3 / §8.3 / §7.6 schedule times. These are interpreted in APP_TIMEZONE
# (above). With APP_TIMEZONE=Europe/London the defaults already match the scope
# doc's UK times — only override if APP_TIMEZONE is something else.
# SIGNALS_DAILY_RUN_TIME=21:30        # §3.3 nightly scoring
# SIGNALS_DIGEST_TIME=21:45           # §8.3 daily digest
# SIGNALS_INTAKE_DIGEST_TIME=18:00    # §7.6 weekly intake digest
# SIGNALS_INTAKE_DIGEST_DAY=sun

# §3.1 TD Sequential sign-off. Leave false until native counts have been
# reconciled against the paid TradingView indicator on 10 reference charts —
# see docs/td-sequential-verification.md. While false, TD completions route to
# the daily digest instead of pushing in real time.
# SIGNALS_TD_COUNTS_VERIFIED=false

# §7.2 inbound email webhook. REQUIRED before /api/signals/intake/email will
# accept anything — it fails closed. HMAC-SHA256 over the raw request body.
SIGNALS_INTAKE_WEBHOOK_SECRET=
# Local development ONLY. Accepts unsigned POSTs; never set this in production.
# SIGNALS_INTAKE_ALLOW_UNSIGNED=false

# §8.6 alert transport. If set, alerts POST here; otherwise they fall back to
# the Telegram credentials above.
# SIGNALS_HERMES_WEBHOOK_URL=
